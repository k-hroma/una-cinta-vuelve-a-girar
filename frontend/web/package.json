{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run typecheck && react-router build",
    "lint": "oxlint",
    "typecheck": "react-router typegen && tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck",
    "preview": "sirv build/client --single __spa-fallback.html --port 4173 --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cms": "vitest run --mode cms src/services/sanity/paginas.cms.test.ts",
    "check:seo": "node scripts/check-seo.ts"
  },
  "dependencies": {
    "@sanity/client": "^8.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.88.0",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
